  "decisions": {
    "delivered_review": "ACCEPT",
    "exact_design_scope": "REVISE",
    "accepted_direction": "Retain the single authoritative Convex transaction, non-reused epoch, and disposable adapter. Keep production identity and invocation as separate decisions."
  },
  "revision_requirements": [
    {
      "id": "A3-A4",
      "change": "Specify current scope and epoch for reuse of an independently found job. Treat legacy rows without those bindings as ineligible for reuse. Add a newly keyed fixture seeded with historical and other-scope same-text jobs. Assert no old identity or payload disclosure and no silent rebinding. Preserve same-key concurrency and stale-before-conflict."
    },
    {
      "id": "A5",
      "change": "Bind the original decoded request, extracted effect, trusted route and compatible engine/index manifest. A protected fragment must neither create an exact whole-request answer nor enter fallback research. Test fragment-only, whole-request protected and incompatible engine/index separately with zero effects and no candidate disclosure."
    },
    {
      "id": "A7",
      "change": "Separate revocation before immediate or partial state persistence from revocation after save and before immediate or saved-progress disclosure. Test both and preserve the already committed job without another enqueue. Define the authority boundary for result writes explicitly because local SQLite and Convex writes are separate."
    }
  ],

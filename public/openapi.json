{
  "openapi": "3.1.0",
  "info": {
    "title": "Fact-ori Evidence API",
    "version": "0.2.0",
    "description": "Public reviewed evidence lookup, model-assessed semantic/paragraph analysis and opt-in research intake. Research progress is separate from factual verdict. Local models may err; inspect scope, review receipts, source dependence and version pins."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service readiness, library revision, inference configuration and public-intake mode",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Initializing or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/check": {
      "post": {
        "summary": "Analyze a question, assertion or paragraph",
        "responses": {
          "200": {
            "description": "Completed result with per-claim results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "202": {
            "description": "Durable analysis accepted: id and poll_url",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or request key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Conflicting key or stale result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "415": {
            "description": "JSON Content-Type required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Unavailable or queue full",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "description": "Exact curated aliases return immediately. Other inputs are decomposed, audited, retrieved and assessed by local models. Poll the returned relative poll_url if HTTP202. Terminal analysis text/results expire24hours after submission under public unguessable IDs; pending work remains until processed. No research is submitted without public_review=true; that consent makes uncovered claims eligible for public Tilori posting. An analysis being complete does not mean every claim was resolved.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Optional binding for non-exact analysis text and public_review choice. Exact alias responses reserve no key."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "public_review": {
                    "type": "boolean",
                    "default": false
                  },
                  "async": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              "example": {
                "text": "How many ml make up a liter?",
                "async": true
              }
            }
          }
        }
      }
    },
    "/v1/checks/{id}": {
      "get": {
        "summary": "Analysis progress and completed or partial results",
        "responses": {
          "200": {
            "description": "Analysis progress, completed result or explicit failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Library changed; partial/completed results withheld",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "summary": "Durable research progress and linked Tilori investigation",
        "responses": {
          "200": {
            "description": "Job text, task status, post ID and observation provenance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Unknown job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/records/{claimId}": {
      "get": {
        "summary": "Inspect exact current reviewed evidence and frozen source history",
        "responses": {
          "200": {
            "description": "Pinned record, evidence package and original source reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Unknown record",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Requested pins are not currently approved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "claimId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "version",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "sha256",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Machine-readable API contract",
        "responses": {
          "200": {
            "description": "OpenAPI3.1 specification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "name": "fact-ori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "dev:local": "CONVEX_AGENT_MODE=anonymous convex dev",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed-convex.mjs",
    "outbox": "node scripts/outbox.mjs",
    "test:api": "node --env-file=.env.local scripts/smoke-api.mjs",
    "test:python": "node scripts/python.mjs -B -m unittest discover -s scripts -p 'test_*.py'",
    "test:convex": "vitest run",
    "test:gateway": "node scripts/test-gateway.mjs",
    "test:semantic": "node service/snapshot-boundary.test.mjs && node service/snapshot-integration.test.mjs && node service/engine.test.mjs && node service/server.test.mjs && node client/check.test.mjs && node scripts/test-seed-stdin.mjs && node scripts/test-semantic-report.mjs",
    "check": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "convex": "1.49.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.0.0",
    "convex-test": "^0.0.67",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
